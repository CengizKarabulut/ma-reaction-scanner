// © cengizkarabulut 2026 — MA Trade Signals v1.0
// MA Reaction Profile tarayıcısının bulduğu robust MA'lar için canlı trade sinyali

//@version=6
indicator("MA Trade Signals", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100)

// =======================================================================
// INPUTS — Hangi MA için sinyal üretileceği (tarayıcıdan al)
// =======================================================================

grp_ma = "MA Ayarları"
ma_type = input.string("HMA", "MA Türü",
     options=["SMA","EMA","WMA","VWMA","HMA","ALMA","KAMA"], group=grp_ma)
ma_period = input.int(21, "Periyot", minval=2, maxval=987, group=grp_ma)

grp_str = "Strateji Parametreleri"
atr_period = input.int(14, "ATR Periyot", minval=2, group=grp_str)
atr_mult_zone = input.float(0.2, "Touch Zone (× ATR)", step=0.05, group=grp_str)
separation_mult = input.float(2.5, "Pre-Separation (× ATR)", step=0.1, group=grp_str)
adx_period = input.int(14, "ADX Periyot", minval=2, group=grp_str)
adx_threshold = input.float(25, "ADX Eşik", step=1, group=grp_str)

grp_tp = "Çıkış Parametreleri"
avg_mfe_pct = input.float(5.0, "Tahmini avg MFE %", step=0.5, group=grp_tp,
     tooltip="Tarayıcının raporladığı avg_mfe değeri")
stop_atr_mult = input.float(1.5, "Stop (× ATR)", step=0.1, group=grp_tp)
max_hold_bars = input.int(10, "Max Tutma Süresi (bar)", minval=1, group=grp_tp)

grp_pos = "Position Sizing"
portfolio = input.float(100000, "Portföy (TL)", step=10000, group=grp_pos)
risk_pct = input.float(1.0, "Risk per Trade (%)", step=0.1, group=grp_pos)

grp_viz = "Görselleştirme"
show_entry = input.bool(true, "Entry sinyalleri", group=grp_viz)
show_levels = input.bool(true, "Stop/TP çizgileri", group=grp_viz)
show_table = input.bool(true, "Durum tablosu", group=grp_viz)
show_labels = input.bool(true, "Etiketler", group=grp_viz)
table_pos = input.string("top_right", "Tablo Konumu", group=grp_viz,
     options=["top_left","top_right","bottom_left","bottom_right","middle_right"])

// =======================================================================
// MA HESAPLAMA FONKSİYONLARI
// =======================================================================

f_alma(src, len) =>
    offset = 0.85
    sigma = 6.0
    m = offset * (len - 1)
    s = len / sigma
    sumW = 0.0
    sumV = 0.0
    for i = 0 to len - 1
        w = math.exp(-math.pow(i - m, 2) / (2 * s * s))
        sumW := sumW + w
        sumV := sumV + w * src[len - 1 - i]
    sumV / sumW

f_kama(src, len) =>
    fast = 2.0
    slow = 30.0
    chg = math.abs(src - src[len])
    vol = 0.0
    for i = 0 to len - 1
        vol := vol + math.abs(src[i] - src[i+1])
    er = vol == 0 ? 0.0 : chg / vol
    sc = math.pow(er * (2.0/(fast+1) - 2.0/(slow+1)) + 2.0/(slow+1), 2)
    var float k = na
    k := na(k[1]) ? src : k[1] + sc * (src - k[1])
    k

f_compute_ma(typ, src, vol, len) =>
    switch typ
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        "HMA"  => ta.hma(src, len)
        "ALMA" => f_alma(src, len)
        "KAMA" => f_kama(src, len)
        => na

ma_value = f_compute_ma(ma_type, close, volume, ma_period)
atr_v = ta.atr(atr_period)
[diplus, diminus, adx] = ta.dmi(adx_period, adx_period)

// =======================================================================
// STATE MACHINE: searching → in_position → exited
// =======================================================================

var int trade_state = 0          // 0=searching, 1=in_position
var bool was_far_enough = false  // Pre-touch separation flag
var float entry_price = na
var float stop_price = na
var float tp1_price = na
var float tp2_price = na
var float trailing_stop = na
var string trade_side = na       // "LONG" or "SHORT"
var int entry_bar = na
var bool tp1_hit = false
var int n_lots = 0

// Pre-touch separation tracking
distance = math.abs(close - ma_value)
if not na(ma_value) and not na(atr_v) and trade_state == 0
    if distance > separation_mult * atr_v
        was_far_enough := true

// Touch detection
in_zone = not na(ma_value) and not na(atr_v) and
          low <= ma_value + atr_mult_zone * atr_v and
          high >= ma_value - atr_mult_zone * atr_v

prev_close_above = close[1] > ma_value[1]
new_touch = in_zone and not in_zone[1] and was_far_enough
adx_ok = not na(adx) and adx > adx_threshold

// =======================================================================
// ENTRY LOGIC
// =======================================================================

if trade_state == 0 and new_touch and adx_ok
    trade_side := prev_close_above ? "LONG" : "SHORT"

    if trade_side == "LONG"
        entry_price := close
        stop_price := ma_value - stop_atr_mult * atr_v
        tp1_price := close * (1 + avg_mfe_pct * 0.5 / 100)
        tp2_price := close * (1 + avg_mfe_pct / 100)
    else
        entry_price := close
        stop_price := ma_value + stop_atr_mult * atr_v
        tp1_price := close * (1 - avg_mfe_pct * 0.5 / 100)
        tp2_price := close * (1 - avg_mfe_pct / 100)

    risk_per_lot = math.abs(entry_price - stop_price)
    if risk_per_lot > 0
        n_lots := int(portfolio * risk_pct / 100 / risk_per_lot)
        if n_lots > 0
            trade_state := 1
            entry_bar := bar_index
            was_far_enough := false
            tp1_hit := false
            trailing_stop := stop_price

// =======================================================================
// EXIT LOGIC (in_position)
// =======================================================================

bars_in_pos = bar_index - entry_bar

if trade_state == 1
    // Stop kontrolü
    if trade_side == "LONG"
        if low <= stop_price
            trade_state := 0
            if show_labels
                label.new(bar_index, stop_price, "STOP", color=color.red,
                     textcolor=color.white, style=label.style_label_up, size=size.small)
        else if low <= trailing_stop and tp1_hit
            trade_state := 0
            if show_labels
                label.new(bar_index, trailing_stop, "TRAIL", color=color.orange,
                     textcolor=color.white, style=label.style_label_up, size=size.small)
        else if high >= tp1_price and not tp1_hit
            tp1_hit := true
            if show_labels
                label.new(bar_index, tp1_price, "TP1", color=color.lime,
                     textcolor=color.black, style=label.style_label_down, size=size.small)
        else if high >= tp2_price and tp1_hit
            trade_state := 0
            if show_labels
                label.new(bar_index, tp2_price, "TP2", color=color.green,
                     textcolor=color.white, style=label.style_label_down, size=size.small)

        // Trailing güncellemesi (TP1 sonrası)
        if tp1_hit and high > high[1]
            new_trail = high - 2 * atr_v
            trailing_stop := math.max(trailing_stop, new_trail)
    else  // SHORT
        if high >= stop_price
            trade_state := 0
            if show_labels
                label.new(bar_index, stop_price, "STOP", color=color.red,
                     textcolor=color.white, style=label.style_label_down, size=size.small)
        else if low <= tp2_price and tp1_hit
            trade_state := 0
            if show_labels
                label.new(bar_index, tp2_price, "TP2", color=color.green,
                     textcolor=color.white, style=label.style_label_up, size=size.small)
        else if low <= tp1_price and not tp1_hit
            tp1_hit := true
            if show_labels
                label.new(bar_index, tp1_price, "TP1", color=color.lime,
                     textcolor=color.black, style=label.style_label_up, size=size.small)

    // Time stop
    if trade_state == 1 and bars_in_pos >= max_hold_bars
        trade_state := 0
        if show_labels
            label.new(bar_index, close, "TIME", color=color.gray,
                 textcolor=color.white, style=label.style_label_down, size=size.small)

// =======================================================================
// PLOT — MA + Levels
// =======================================================================

plot(ma_value, "MA", color=color.blue, linewidth=2)

stop_plot = trade_state == 1 ? stop_price : na
tp1_plot = trade_state == 1 ? tp1_price : na
tp2_plot = trade_state == 1 ? tp2_price : na
entry_plot = trade_state == 1 ? entry_price : na

plot(show_levels ? entry_plot : na, "Entry", color=color.new(color.yellow, 0),
     linewidth=1, style=plot.style_linebr)
plot(show_levels ? stop_plot : na, "Stop", color=color.new(color.red, 0),
     linewidth=1, style=plot.style_linebr)
plot(show_levels ? tp1_plot : na, "TP1", color=color.new(color.lime, 0),
     linewidth=1, style=plot.style_linebr)
plot(show_levels ? tp2_plot : na, "TP2", color=color.new(color.green, 0),
     linewidth=1, style=plot.style_linebr)

// Trailing stop (TP1 sonrası)
trail_plot = (trade_state == 1 and tp1_hit) ? trailing_stop : na
plot(show_levels ? trail_plot : na, "Trailing", color=color.new(color.orange, 0),
     linewidth=1, style=plot.style_linebr)

// Entry sinyali (yeşil/kırmızı ok)
entry_signal = trade_state == 1 and trade_state[1] == 0
plotshape(show_entry and entry_signal and trade_side == "LONG",
     "Long Entry", shape.triangleup, location.belowbar,
     color=color.lime, size=size.normal, text="LONG")
plotshape(show_entry and entry_signal and trade_side == "SHORT",
     "Short Entry", shape.triangledown, location.abovebar,
     color=color.red, size=size.normal, text="SHORT")

// Setup hazır işareti (was_far_enough true, beklemede)
setup_ready = was_far_enough and trade_state == 0 and math.abs(close - ma_value) < separation_mult * atr_v * 1.5
plotshape(setup_ready and not setup_ready[1], "Setup Ready", shape.diamond,
     location.bottom, color=color.new(color.yellow, 0), size=size.tiny)

// =======================================================================
// BACKGROUND COLOR — In position highlighting
// =======================================================================

bgcolor(trade_state == 1 and trade_side == "LONG" ? color.new(color.green, 92) :
        trade_state == 1 and trade_side == "SHORT" ? color.new(color.red, 92) :
        was_far_enough and trade_state == 0 ? color.new(color.yellow, 95) : na,
        title="State BG")

// =======================================================================
// BİLGİ TABLOSU
// =======================================================================

var table info_table = na
if barstate.islast and show_table
    table.delete(info_table)
    pos = table_pos == "top_left" ? position.top_left :
          table_pos == "top_right" ? position.top_right :
          table_pos == "bottom_left" ? position.bottom_left :
          table_pos == "bottom_right" ? position.bottom_right : position.middle_right
    info_table := table.new(pos, 2, 14, bgcolor=color.new(color.black, 20),
                            border_width=1, border_color=color.gray)

    table.cell(info_table, 0, 0, "MA Trade Signals", text_color=color.aqua, text_size=size.normal)
    table.cell(info_table, 1, 0, ma_type + " " + str.tostring(ma_period), text_color=color.white)

    state_txt = trade_state == 0 ? (was_far_enough ? "SETUP READY" : "SEARCHING") : ("IN POSITION (" + trade_side + ")")
    state_clr = trade_state == 0 ? (was_far_enough ? color.yellow : color.gray) : (trade_side == "LONG" ? color.lime : color.red)
    table.cell(info_table, 0, 1, "Durum", text_color=color.silver)
    table.cell(info_table, 1, 1, state_txt, text_color=state_clr)

    table.cell(info_table, 0, 2, "MA Değer", text_color=color.silver)
    table.cell(info_table, 1, 2, na(ma_value) ? "—" : str.tostring(ma_value, format.mintick), text_color=color.white)

    dist_atr = na(ma_value) or na(atr_v) ? na : (close - ma_value) / atr_v
    table.cell(info_table, 0, 3, "Uzaklık (ATR)", text_color=color.silver)
    table.cell(info_table, 1, 3, na(dist_atr) ? "—" : str.tostring(dist_atr, "+0.00"),
        text_color=math.abs(dist_atr) > separation_mult ? color.lime : color.gray)

    table.cell(info_table, 0, 4, "ATR", text_color=color.silver)
    table.cell(info_table, 1, 4, na(atr_v) ? "—" : str.tostring(atr_v, format.mintick), text_color=color.white)

    table.cell(info_table, 0, 5, "ADX", text_color=color.silver)
    table.cell(info_table, 1, 5, na(adx) ? "—" : str.tostring(adx, "0.0"),
        text_color=adx > adx_threshold ? color.lime : color.gray)

    if trade_state == 1
        table.cell(info_table, 0, 6, "Entry", text_color=color.silver)
        table.cell(info_table, 1, 6, str.tostring(entry_price, format.mintick), text_color=color.white)

        table.cell(info_table, 0, 7, "Stop", text_color=color.silver)
        table.cell(info_table, 1, 7, str.tostring(stop_price, format.mintick), text_color=color.red)

        table.cell(info_table, 0, 8, "TP1", text_color=color.silver)
        table.cell(info_table, 1, 8, str.tostring(tp1_price, format.mintick) + (tp1_hit ? " ✓" : ""),
            text_color=tp1_hit ? color.lime : color.aqua)

        table.cell(info_table, 0, 9, "TP2", text_color=color.silver)
        table.cell(info_table, 1, 9, str.tostring(tp2_price, format.mintick), text_color=color.aqua)

        if tp1_hit
            table.cell(info_table, 0, 10, "Trail", text_color=color.silver)
            table.cell(info_table, 1, 10, str.tostring(trailing_stop, format.mintick), text_color=color.orange)

        table.cell(info_table, 0, 11, "Lot", text_color=color.silver)
        table.cell(info_table, 1, 11, str.tostring(n_lots), text_color=color.white)

        risk_pct_actual = math.abs(entry_price - stop_price) * n_lots / portfolio * 100
        table.cell(info_table, 0, 12, "Risk%", text_color=color.silver)
        table.cell(info_table, 1, 12, str.tostring(risk_pct_actual, "0.00"), text_color=color.yellow)

        table.cell(info_table, 0, 13, "Bar", text_color=color.silver)
        table.cell(info_table, 1, 13, str.tostring(bars_in_pos) + "/" + str.tostring(max_hold_bars),
            text_color=bars_in_pos > max_hold_bars * 0.7 ? color.orange : color.white)
    else
        table.cell(info_table, 0, 6, "Hint", text_color=color.silver)
        hint = was_far_enough ? "Touch + ADX bekleniyor" : "Fiyat MA'dan uzaklaşmalı"
        table.cell(info_table, 1, 6, hint, text_color=color.yellow)

// =======================================================================
// ALERT CONDITIONS
// =======================================================================

alertcondition(entry_signal and trade_side == "LONG",
     title="LONG Entry",
     message="LONG entry: {{ticker}} @ {{close}} | Stop: " + str.tostring(stop_price))
alertcondition(entry_signal and trade_side == "SHORT",
     title="SHORT Entry",
     message="SHORT entry: {{ticker}} @ {{close}} | Stop: " + str.tostring(stop_price))
alertcondition(setup_ready,
     title="Setup Ready",
     message="Setup: {{ticker}} MA'ya yaklaşıyor — touch bekleniyor")
