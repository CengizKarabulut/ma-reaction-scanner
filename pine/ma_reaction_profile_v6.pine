// =================== TABLO 1: MEVCUT TF (REJİM AYRIMLI) ===================

// =====================================================================
// AUTO-DRAW: input ve helper fonksiyon (tablo bloğundan önce tanımlı olmalı)
// =====================================================================
g_auto = "7. Otomatik Çizim"
auto_draw_n = input.int(4, "Otomatik çizilecek MA sayısı", minval=0, maxval=8, group=g_auto,
     tooltip="Tablonun en üstündeki bu kadar MA otomatik çizilir. 0 = kapalı")
draw_lookback = input.int(250, "Geriye dönük bar sayısı", minval=50, maxval=300, group=g_auto,
     tooltip="MA'lar bu kadar bar geriye doğru çizilir. Pine v6 max_bars_back limiti nedeniyle max 300.")
draw_width = input.int(2, "Çizgi kalınlığı", minval=1, maxval=4, group=g_auto)
show_auto_label = input.bool(true, "Sağ kenarda etiket göster", group=g_auto)

// Index'e ve geriye-mesafe k'ya göre MA değerini döndüren helper'lar
// Pine v6 external element limiti (254) nedeniyle 3 alt fonksiyona bölündü
get_ma_at_a(idx, k) =>
    switch idx
        0 => sma_3[k]
        1 => sma_5[k]
        2 => sma_8[k]
        3 => sma_10[k]
        4 => sma_13[k]
        5 => sma_20[k]
        6 => sma_21[k]
        7 => sma_22[k]
        8 => sma_34[k]
