//@version=6
// =====================================================================
// MA TEPKİ PROFİLİ v5 - MATRIX TABLO
// v6 = v5 + KAVRAMSAL DÜZELTMELER:
//   ✓ Pre-touch separation requirement (kısa MA "sahte saygı" bias'ı düzeltildi)
//   ✓ Breakthrough count (MA'nın gerçekten kırılıp kırılmadığını sayar)
//   ✓ Composite skor: expectancy × √touches × respect_ratio
//   ✓ Görsel: yakın MA'lar bant, tekil MA'lar kısa çizgi (sağa uzar)
//   ✗ Speed_sum kaldırıldı (limit yer açmak için, görsel olarak Hız sütunu çıktı)
// v4'ten değişiklikler:
//   ✓ Matrix tablo (sütun=MA türü, satır=periyot)
//   ✓ Tablo konumları input ile seçilebilir
//   ✓ Otomatik seçilen MA'lar hücrede vurgulu
//   ✓ Etiketler x_offset ile yan yana + değerleri görünür
//   ✓ Tepki büyüklüğü: touch_price referansı (MA değeri yerine)
//   ✓ Composite skor: win_rate × log(touches+1) - overfitting azaltma
//   ✓ Min dokunma varsayılan 10 (3 yerine)
// Yenilik: Tablodan en tepkili N MA'yı OTOMATİK olarak grafiğe çizer.
// Manuel dropdown yok - tablo neyi en üste koyarsa o çizilir.
// Pine v6 polyline kullanır.
// =====================================================================
indicator("MA Tepki Profili v6 - Otomatik", overlay=true,
     max_labels_count=100,
     max_lines_count=100,
     max_polylines_count=20,
     max_bars_back=2000)

// === Çizim nesneleri yönetimi (memory leak önleme) ===
var array<line> active_lines = array.new<line>()
var array<box> active_boxes = array.new<box>()
var array<label> active_labels = array.new<label>()

// =================== AYARLAR ===================
g1 = "1. MA Türleri"
use_sma  = input.bool(true,  "SMA",  inline="ty1", group=g1)
use_ema  = input.bool(true,  "EMA",  inline="ty1", group=g1)
use_wma  = input.bool(false, "WMA",  inline="ty1", group=g1)
use_vwma = input.bool(false, "VWMA", inline="ty1", group=g1)
use_kama = input.bool(false, "KAMA", inline="ty2", group=g1, tooltip="Kaufman Adaptive MA")
use_alma = input.bool(false, "ALMA", inline="ty2", group=g1, tooltip="Arnaud Legoux MA")
use_hma  = input.bool(false, "HMA",  inline="ty2", group=g1, tooltip="Hull MA")

g2 = "2. Periyotlar"
p3   = input.bool(true,  "3",   inline="r1", group=g2)
p5   = input.bool(true,  "5",   inline="r1", group=g2)
p8   = input.bool(true,  "8",   inline="r1", group=g2)
p10  = input.bool(true,  "10",  inline="r1", group=g2)
p13  = input.bool(true,  "13",  inline="r1", group=g2)
p20  = input.bool(true,  "20",  inline="r2", group=g2)
p21  = input.bool(true,  "21",  inline="r2", group=g2)
p22  = input.bool(false, "22",  inline="r2", group=g2)
p34  = input.bool(true,  "34",  inline="r2", group=g2)
p50  = input.bool(true,  "50",  inline="r2", group=g2)
p55  = input.bool(false, "55",  inline="r3", group=g2)
p89  = input.bool(true,  "89",  inline="r3", group=g2)
p100 = input.bool(true,  "100", inline="r3", group=g2)
p144 = input.bool(true,  "144", inline="r3", group=g2)
p200 = input.bool(true,  "200", inline="r3", group=g2)
p233 = input.bool(false, "233", inline="r4", group=g2)
p250 = input.bool(false, "250", inline="r4", group=g2)
p377 = input.bool(false, "377 ⚠", inline="r4", group=g2, tooltip="Uzun MA: yeterli sonuç için ≥1500 bar veri gerekir, açmadan önce dikkat")
p610 = input.bool(false, "610 ⚠", inline="r4", group=g2, tooltip="Uzun MA: yeterli sonuç için ≥2000 bar veri gerekir")
p987 = input.bool(false, "987 ⚠", inline="r4", group=g2, tooltip="Uzun MA: yeterli sonuç için ≥3000 bar veri gerekir")

g3 = "3. Dokunma & Tepki Tanımı"
atr_len    = input.int(14, "ATR periyodu", minval=5, group=g3)
atr_mult   = input.float(0.2, "Dokunma toleransı (× ATR)", minval=0.0, step=0.05, group=g3,
     tooltip="MA ± (k×ATR) zone'u. Volatil günlerde geniş, sakin günlerde dar.")
react_pct  = input.float(1.5, "Min tepki büyüklüğü (%)", minval=0.3, step=0.1, group=g3)
react_bars = input.int(5, "Tepki kontrol penceresi (bar)", minval=2, maxval=20, group=g3)
min_touches= input.int(10, "Min toplam dokunma", minval=1, group=g3)

g4 = "4. Rejim Filtresi (ADX)"
adx_len       = input.int(14, "ADX periyodu", minval=5, group=g4)
adx_threshold = input.float(25.0, "Trend/yatay eşiği", minval=10.0, maxval=50.0, step=1.0, group=g4,
     tooltip="ADX > eşik → trendli sayılır, altı → yatay")

g5 = "5. Üst Zaman Dilimleri"
show_htf = input.bool(true, "MTF tablolarını göster", group=g5)
htf1 = input.timeframe("W", "ÜZD 1 (haftalık)", group=g5)
htf2 = input.timeframe("M", "ÜZD 2 (aylık)", group=g5)

g6 = "6. Görüntü ve Pozisyonlar"
plot_top_n   = input.int(4, "Otomatik vurgulu/çizilen MA sayısı", minval=0, maxval=8, group=g6,
     tooltip="Tabloda renkli vurgu + grafikte otomatik çizim")
table_size_s = input.string("küçük", "Tablo yazı boyutu", options=["küçük","normal","büyük"], group=g6)
pos_main_s = input.string("Sol Üst", "Ana matrix tablo konumu",
     options=["Sol Üst","Sol Orta","Sol Alt","Orta Üst","Orta","Orta Alt","Sağ Üst","Sağ Orta","Sağ Alt"], group=g6)
pos_mtf_s = input.string("Sağ Üst", "MTF (haftalık + aylık) konumu",
     options=["Sol Üst","Sol Orta","Sol Alt","Orta Üst","Orta","Orta Alt","Sağ Üst","Sağ Orta","Sağ Alt"], group=g6,
     tooltip="Haftalık ve aylık MA değerlerinin birleşik tablosu")
mtf_view_s = input.string("Haftalık", "MTF tablosu hangi zaman dilimi göstersin",
     options=["Haftalık","Aylık"], group=g6,
     tooltip="Haftalık (W) veya aylık (M) MA'lar matrix olarak gösterilir")
pos_best_s = input.string("Sağ Orta", "En İyiler özet tablosu konumu",
     options=["Sol Üst","Sol Orta","Sol Alt","Orta Üst","Orta","Orta Alt","Sağ Üst","Sağ Orta","Sağ Alt"], group=g6,
     tooltip="Composite skora göre en iyi N MA'yı tek tabloda gösterir")

pos_str_to_pos(s) =>
    switch s
        "Sol Üst"    => position.top_left
        "Sol Orta"   => position.middle_left
        "Sol Alt"    => position.bottom_left
        "Orta Üst"   => position.top_center
        "Orta"       => position.middle_center
        "Orta Alt"   => position.bottom_center
        "Sağ Üst"    => position.top_right
        "Sağ Orta"   => position.middle_right
        "Sağ Alt"    => position.bottom_right
        => position.top_right

pos_main = pos_str_to_pos(pos_main_s)
pos_mtf = pos_str_to_pos(pos_mtf_s)
pos_best = pos_str_to_pos(pos_best_s)

table_size = switch table_size_s
    "küçük"  => size.small
    "normal" => size.normal
    "büyük"  => size.large

// =================== YARDIMCI: KAMA (Pine'da built-in yok) ===================
f_kama(src, len) =>
    fastest_sc = 2.0 / (2 + 1)
    slowest_sc = 2.0 / (30 + 1)
    change = math.abs(src - src[len])
    volatility = math.sum(math.abs(src - src[1]), len)
    er = volatility != 0 ? change / volatility : 0
    sc = math.pow(er * (fastest_sc - slowest_sc) + slowest_sc, 2)
    var float kama_val = na
    kama_val := na(kama_val[1]) ? src : kama_val[1] + sc * (src - kama_val[1])
    kama_val

// =================== REJİM HESABI (ADX) ===================
atr = ta.atr(atr_len)
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)
is_trending = adx > adx_threshold

// =================== TEPKİ SAYACI (REJİM AYRIMLI, ATR TABANLI) ===================
// Her call site kendi 4 sayacını tutar: trend_t, trend_r, range_t, range_r
process_r(ma, enabled) =>
    var int trend_t = 0
    var int trend_r = 0
    var int range_t = 0
    var int range_r = 0
    var float react_sum = 0.0       // başarılı tepkilerin MFE toplamı
    var float mae_sum   = 0.0       // TÜM dokunmaların MAE toplamı
    var int   brk_count = 0         // YENİ v6: kırılım sayısı (MA'yı geçip kalıcı kalma)
    var bool  prev_in_zone   = false
    var bool  was_far_enough = false  // YENİ v6: touch sayılması için önce uzaklaşma şartı
    var bool  was_above      = false  // YENİ v6: yön tracking (kırılım tespiti için)
    var int   bars_since_cross = 0    // YENİ v6: cross sonrası kaç bar geçti

    if enabled and not na(ma) and not na(atr)
        zone = atr_mult * atr
        in_zone = low <= ma + zone and high >= ma - zone
        
        // Touch öncesi separation şartı: fiyat MA'dan en az separation_mult × ATR uzaklaştı mı?
        distance_from_ma = math.abs(close - ma)
        if not in_zone and distance_from_ma > atr * separation_mult
            was_far_enough := true
        
        // Touch yalnızca pre-separation şartı sağlandıysa geçerli
        new_touch = in_zone and not prev_in_zone and was_far_enough
        if new_touch
            if is_trending
                trend_t += 1
            else
                range_t += 1
            was_far_enough := false  // Reset, yeni touch için tekrar uzaklaşma şart
        prev_in_zone := in_zone
        
        // Kırılım tespiti: fiyat MA'yı geçtikten sonra breakthrough_bars boyunca öbür tarafta kalırsa
        currently_above = close > ma
        if barstate.isconfirmed
            if currently_above != was_above
                // Yön değişti - cross oldu
                bars_since_cross := 0
                was_above := currently_above
            else
                bars_since_cross += 1
                // breakthrough_bars boyunca aynı yönde durdu mu? (sadece bir kez kayda al)
                if bars_since_cross == breakthrough_bars
                    brk_count += 1

    if enabled
        ma_then = ma[react_bars]
        ma_prev = ma[react_bars + 1]
        ref_close = close[react_bars + 1]
        touch_price = close[react_bars]
        atr_then = atr[react_bars]
        was_trending = is_trending[react_bars]
        if not na(ma_then) and not na(ma_prev) and not na(ref_close) and not na(atr_then) and not na(touch_price)
            zt = atr_mult * atr_then
            in_zone_then = low[react_bars] <= ma_then + zt and high[react_bars] >= ma_then - zt
            in_zone_prev = low[react_bars+1] <= ma_prev + zt and high[react_bars+1] >= ma_prev - zt
            new_touch_then = in_zone_then and not in_zone_prev
            if new_touch_then
                from_above = ref_close > ma_prev
                max_fav_price = from_above ? high : low
                max_adv_price = from_above ? low : high
                for fb = 1 to react_bars - 1
                    cand_fav = from_above ? high[fb] : low[fb]
                    cand_adv = from_above ? low[fb] : high[fb]
                    if from_above
                        max_fav_price := math.max(max_fav_price, cand_fav)
                        max_adv_price := math.min(max_adv_price, cand_adv)
                    else
                        max_fav_price := math.min(max_fav_price, cand_fav)
                        max_adv_price := math.max(max_adv_price, cand_adv)
                
                move = from_above ? (max_fav_price - touch_price)/touch_price*100 : (touch_price - max_fav_price)/touch_price*100
                adverse = from_above ? (touch_price - max_adv_price)/touch_price*100 : (max_adv_price - touch_price)/touch_price*100
                
                mae_sum += adverse
                
                if move >= react_pct
                    react_sum += move
                    if was_trending
                        trend_r += 1
                    else
                        range_r += 1
    [trend_t, trend_r, range_t, range_r, react_sum, mae_sum, brk_count]

