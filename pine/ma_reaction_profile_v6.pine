// Dispatcher kaldırıldı: Pine v6 alt-fonksiyonların element sayısını üst fonksiyona ekliyor.
// Auto-draw bloğunda inline dispatch yapılıyor.

// Otomatik çizim - tablo sıralamasından sonra çalışır
// idx_list ve nf değişkenleri tablo bölümünden geliyor (barstate.islast scope'unda)

var table tbl_main = table.new(pos_main, 8, 22, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.gray)
var table tbl_mtf = table.new(pos_mtf, 8, 22, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.gray)
var table tbl_best = table.new(pos_best, 13, 10, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.gray)

if barstate.islast
    // === ESKİ ÇİZİMLERİ TEMİZLE (her tikte yeniden çiziliyor) ===
    if array.size(active_lines) > 0
        for ln in active_lines
            line.delete(ln)
        array.clear(active_lines)
    if array.size(active_boxes) > 0
        for bx in active_boxes
            box.delete(bx)
        array.clear(active_boxes)
    if array.size(active_labels) > 0
        for lb in active_labels
            label.delete(lb)
        array.clear(active_labels)
    
    // Tüm 140 satırın bilgilerini topla
    all_types = array.from(
         "SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA","SMA",
         "EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA","EMA",
         "WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA","WMA",
         "VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA","VWMA",
         "KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA","KAMA",
         "ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA","ALMA",
         "HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA","HMA")
    period_seq = array.from(3,5,8,10,13,20,21,22,34,50,55,89,100,144,200,233,250,377,610,987)
    all_pers = array.new<int>()
    for grp_idx = 0 to 6
        for pi = 0 to 19
            array.push(all_pers, array.get(period_seq, pi))
    all_mas = array.from(
         sma_3,sma_5,sma_8,sma_10,sma_13,sma_20,sma_21,sma_22,sma_34,sma_50,sma_55,sma_89,sma_100,sma_144,sma_200,sma_233,sma_250,sma_377,sma_610,sma_987,
         ema_3,ema_5,ema_8,ema_10,ema_13,ema_20,ema_21,ema_22,ema_34,ema_50,ema_55,ema_89,ema_100,ema_144,ema_200,ema_233,ema_250,ema_377,ema_610,ema_987,
         wma_3,wma_5,wma_8,wma_10,wma_13,wma_20,wma_21,wma_22,wma_34,wma_50,wma_55,wma_89,wma_100,wma_144,wma_200,wma_233,wma_250,wma_377,wma_610,wma_987,
         vwma_3,vwma_5,vwma_8,vwma_10,vwma_13,vwma_20,vwma_21,vwma_22,vwma_34,vwma_50,vwma_55,vwma_89,vwma_100,vwma_144,vwma_200,vwma_233,vwma_250,vwma_377,vwma_610,vwma_987,
         kama_3,kama_5,kama_8,kama_10,kama_13,kama_20,kama_21,kama_22,kama_34,kama_50,kama_55,kama_89,kama_100,kama_144,kama_200,kama_233,kama_250,kama_377,kama_610,kama_987,
         alma_3,alma_5,alma_8,alma_10,alma_13,alma_20,alma_21,alma_22,alma_34,alma_50,alma_55,alma_89,alma_100,alma_144,alma_200,alma_233,alma_250,alma_377,alma_610,alma_987,
         hma_3,hma_5,hma_8,hma_10,hma_13,hma_20,hma_21,hma_22,hma_34,hma_50,hma_55,hma_89,hma_100,hma_144,hma_200,hma_233,hma_250,hma_377,hma_610,hma_987)
    trend_touches = array.from(tt01,tt02,tt03,tt04,tt05,tt06,tt07,tt08,tt09,tt10,tt11,tt12,tt13,tt14,tt15,tt16,tt17,tt18,tt19,tt20,
                                tt21,tt22,tt23,tt24,tt25,tt26,tt27,tt28,tt29,tt30,tt31,tt32,tt33,tt34,tt35,tt36,tt37,tt38,tt39,tt40,
                                tt41,tt42,tt43,tt44,tt45,tt46,tt47,tt48,tt49,tt50,tt51,tt52,tt53,tt54,tt55,tt56,tt57,tt58,tt59,tt60,
                                tt61,tt62,tt63,tt64,tt65,tt66,tt67,tt68,tt69,tt70,tt71,tt72,tt73,tt74,tt75,tt76,tt77,tt78,tt79,tt80,
                                tt81,tt82,tt83,tt84,tt85,tt86,tt87,tt88,tt89,tt90,tt91,tt92,tt93,tt94,tt95,tt96,tt97,tt98,tt99,tt100,
                                tt101,tt102,tt103,tt104,tt105,tt106,tt107,tt108,tt109,tt110,tt111,tt112,tt113,tt114,tt115,tt116,tt117,tt118,tt119,tt120,
                                tt121,tt122,tt123,tt124,tt125,tt126,tt127,tt128,tt129,tt130,tt131,tt132,tt133,tt134,tt135,tt136,tt137,tt138,tt139,tt140)
    trend_reacts  = array.from(tr01,tr02,tr03,tr04,tr05,tr06,tr07,tr08,tr09,tr10,tr11,tr12,tr13,tr14,tr15,tr16,tr17,tr18,tr19,tr20,
                                tr21,tr22,tr23,tr24,tr25,tr26,tr27,tr28,tr29,tr30,tr31,tr32,tr33,tr34,tr35,tr36,tr37,tr38,tr39,tr40,
                                tr41,tr42,tr43,tr44,tr45,tr46,tr47,tr48,tr49,tr50,tr51,tr52,tr53,tr54,tr55,tr56,tr57,tr58,tr59,tr60,
                                tr61,tr62,tr63,tr64,tr65,tr66,tr67,tr68,tr69,tr70,tr71,tr72,tr73,tr74,tr75,tr76,tr77,tr78,tr79,tr80,
                                tr81,tr82,tr83,tr84,tr85,tr86,tr87,tr88,tr89,tr90,tr91,tr92,tr93,tr94,tr95,tr96,tr97,tr98,tr99,tr100,
                                tr101,tr102,tr103,tr104,tr105,tr106,tr107,tr108,tr109,tr110,tr111,tr112,tr113,tr114,tr115,tr116,tr117,tr118,tr119,tr120,
                                tr121,tr122,tr123,tr124,tr125,tr126,tr127,tr128,tr129,tr130,tr131,tr132,tr133,tr134,tr135,tr136,tr137,tr138,tr139,tr140)
    range_touches = array.from(rt01,rt02,rt03,rt04,rt05,rt06,rt07,rt08,rt09,rt10,rt11,rt12,rt13,rt14,rt15,rt16,rt17,rt18,rt19,rt20,
                                rt21,rt22,rt23,rt24,rt25,rt26,rt27,rt28,rt29,rt30,rt31,rt32,rt33,rt34,rt35,rt36,rt37,rt38,rt39,rt40,
                                rt41,rt42,rt43,rt44,rt45,rt46,rt47,rt48,rt49,rt50,rt51,rt52,rt53,rt54,rt55,rt56,rt57,rt58,rt59,rt60,
                                rt61,rt62,rt63,rt64,rt65,rt66,rt67,rt68,rt69,rt70,rt71,rt72,rt73,rt74,rt75,rt76,rt77,rt78,rt79,rt80,
                                rt81,rt82,rt83,rt84,rt85,rt86,rt87,rt88,rt89,rt90,rt91,rt92,rt93,rt94,rt95,rt96,rt97,rt98,rt99,rt100,
                                rt101,rt102,rt103,rt104,rt105,rt106,rt107,rt108,rt109,rt110,rt111,rt112,rt113,rt114,rt115,rt116,rt117,rt118,rt119,rt120,
                                rt121,rt122,rt123,rt124,rt125,rt126,rt127,rt128,rt129,rt130,rt131,rt132,rt133,rt134,rt135,rt136,rt137,rt138,rt139,rt140)
    range_reacts  = array.from(rr01,rr02,rr03,rr04,rr05,rr06,rr07,rr08,rr09,rr10,rr11,rr12,rr13,rr14,rr15,rr16,rr17,rr18,rr19,rr20,
                                rr21,rr22,rr23,rr24,rr25,rr26,rr27,rr28,rr29,rr30,rr31,rr32,rr33,rr34,rr35,rr36,rr37,rr38,rr39,rr40,
                                rr41,rr42,rr43,rr44,rr45,rr46,rr47,rr48,rr49,rr50,rr51,rr52,rr53,rr54,rr55,rr56,rr57,rr58,rr59,rr60,
                                rr61,rr62,rr63,rr64,rr65,rr66,rr67,rr68,rr69,rr70,rr71,rr72,rr73,rr74,rr75,rr76,rr77,rr78,rr79,rr80,
                                rr81,rr82,rr83,rr84,rr85,rr86,rr87,rr88,rr89,rr90,rr91,rr92,rr93,rr94,rr95,rr96,rr97,rr98,rr99,rr100,
                                rr101,rr102,rr103,rr104,rr105,rr106,rr107,rr108,rr109,rr110,rr111,rr112,rr113,rr114,rr115,rr116,rr117,rr118,rr119,rr120,
                                rr121,rr122,rr123,rr124,rr125,rr126,rr127,rr128,rr129,rr130,rr131,rr132,rr133,rr134,rr135,rr136,rr137,rr138,rr139,rr140)
    react_sums = array.from(rs01,rs02,rs03,rs04,rs05,rs06,rs07,rs08,rs09,rs10,rs11,rs12,rs13,rs14,rs15,rs16,rs17,rs18,rs19,rs20,
                             rs21,rs22,rs23,rs24,rs25,rs26,rs27,rs28,rs29,rs30,rs31,rs32,rs33,rs34,rs35,rs36,rs37,rs38,rs39,rs40,
                             rs41,rs42,rs43,rs44,rs45,rs46,rs47,rs48,rs49,rs50,rs51,rs52,rs53,rs54,rs55,rs56,rs57,rs58,rs59,rs60,
                             rs61,rs62,rs63,rs64,rs65,rs66,rs67,rs68,rs69,rs70,rs71,rs72,rs73,rs74,rs75,rs76,rs77,rs78,rs79,rs80,
                             rs81,rs82,rs83,rs84,rs85,rs86,rs87,rs88,rs89,rs90,rs91,rs92,rs93,rs94,rs95,rs96,rs97,rs98,rs99,rs100,
                             rs101,rs102,rs103,rs104,rs105,rs106,rs107,rs108,rs109,rs110,rs111,rs112,rs113,rs114,rs115,rs116,rs117,rs118,rs119,rs120,
                             rs121,rs122,rs123,rs124,rs125,rs126,rs127,rs128,rs129,rs130,rs131,rs132,rs133,rs134,rs135,rs136,rs137,rs138,rs139,rs140)
    mae_sums = array.from(ma01,ma02,ma03,ma04,ma05,ma06,ma07,ma08,ma09,ma10,ma11,ma12,ma13,ma14,ma15,ma16,ma17,ma18,ma19,ma20,
                          ma21,ma22,ma23,ma24,ma25,ma26,ma27,ma28,ma29,ma30,ma31,ma32,ma33,ma34,ma35,ma36,ma37,ma38,ma39,ma40,
                          ma41,ma42,ma43,ma44,ma45,ma46,ma47,ma48,ma49,ma50,ma51,ma52,ma53,ma54,ma55,ma56,ma57,ma58,ma59,ma60,
                          ma61,ma62,ma63,ma64,ma65,ma66,ma67,ma68,ma69,ma70,ma71,ma72,ma73,ma74,ma75,ma76,ma77,ma78,ma79,ma80,
                          ma81,ma82,ma83,ma84,ma85,ma86,ma87,ma88,ma89,ma90,ma91,ma92,ma93,ma94,ma95,ma96,ma97,ma98,ma99,ma100,
                          ma101,ma102,ma103,ma104,ma105,ma106,ma107,ma108,ma109,ma110,ma111,ma112,ma113,ma114,ma115,ma116,ma117,ma118,ma119,ma120,
                          ma121,ma122,ma123,ma124,ma125,ma126,ma127,ma128,ma129,ma130,ma131,ma132,ma133,ma134,ma135,ma136,ma137,ma138,ma139,ma140)
    brk_counts = array.from(bk01,bk02,bk03,bk04,bk05,bk06,bk07,bk08,bk09,bk10,bk11,bk12,bk13,bk14,bk15,bk16,bk17,bk18,bk19,bk20,
                            bk21,bk22,bk23,bk24,bk25,bk26,bk27,bk28,bk29,bk30,bk31,bk32,bk33,bk34,bk35,bk36,bk37,bk38,bk39,bk40,
                            bk41,bk42,bk43,bk44,bk45,bk46,bk47,bk48,bk49,bk50,bk51,bk52,bk53,bk54,bk55,bk56,bk57,bk58,bk59,bk60,
                            bk61,bk62,bk63,bk64,bk65,bk66,bk67,bk68,bk69,bk70,bk71,bk72,bk73,bk74,bk75,bk76,bk77,bk78,bk79,bk80,
                            bk81,bk82,bk83,bk84,bk85,bk86,bk87,bk88,bk89,bk90,bk91,bk92,bk93,bk94,bk95,bk96,bk97,bk98,bk99,bk100,
                            bk101,bk102,bk103,bk104,bk105,bk106,bk107,bk108,bk109,bk110,bk111,bk112,bk113,bk114,bk115,bk116,bk117,bk118,bk119,bk120,
                            bk121,bk122,bk123,bk124,bk125,bk126,bk127,bk128,bk129,bk130,bk131,bk132,bk133,bk134,bk135,bk136,bk137,bk138,bk139,bk140)
    
    // Filtrele + sırala (toplam tepki oranına göre)
    n = array.size(all_mas)
    idx_list = array.new<int>()
    for i = 0 to n - 1
        tot = array.get(trend_touches, i) + array.get(range_touches, i)
        ma_v = array.get(all_mas, i)
        if tot >= min_touches and not na(ma_v)
            array.push(idx_list, i)
    
    // Composite skor: win_rate × log(touches+1) - hem başarı hem örneklem büyüklüğü
    rates = array.new<float>()       // raw win_rate % (renk için)
    scores = array.new<float>()      // composite (sıralama için)
    expectancies = array.new<float>() // expectancy değerleri
    for i = 0 to array.size(idx_list) - 1
        ix = array.get(idx_list, i)
        tot_t = array.get(trend_touches, ix) + array.get(range_touches, ix)
        tot_r = array.get(trend_reacts, ix) + array.get(range_reacts, ix)
        wr_decimal = tot_t > 0 ? tot_r / tot_t : 0
        wr = wr_decimal * 100.0
        avg_mfe = tot_r > 0 ? array.get(react_sums, ix) / tot_r : 0.0
        avg_mae = tot_t > 0 ? array.get(mae_sums, ix) / tot_t : 0.0
        // Expectancy: WR×Avg_MFE − (1−WR)×Avg_MAE
        expectancy = wr_decimal * avg_mfe - (1 - wr_decimal) * avg_mae
        // YENİ v6: respect_ratio - MA gerçekten kırılmadan kalıyor mu?
        brk = array.get(brk_counts, ix)
        respect_ratio = tot_t > 0 ? math.max(0.0, 1.0 - brk / math.max(tot_t, 1)) : 0.0
        array.push(rates, wr)
        array.push(expectancies, expectancy)
        // Composite skor v6: expectancy × √touches × respect_ratio (kırılan MA puan kaybeder)
        array.push(scores, expectancy * math.sqrt(tot_t) * respect_ratio)
    
    // Composite skora göre sırala (yan etkide rates de hizalanır)
    nf = array.size(idx_list)
    if nf > 0
        for i = 0 to nf - 2
            max_i = i
            for j = i + 1 to nf - 1
                if array.get(scores, j) > array.get(scores, max_i)
                    max_i := j
            if max_i != i
                t1 = array.get(idx_list, i)
                array.set(idx_list, i, array.get(idx_list, max_i))
                array.set(idx_list, max_i, t1)
                t2 = array.get(rates, i)
                array.set(rates, i, array.get(rates, max_i))
                array.set(rates, max_i, t2)
                t3 = array.get(scores, i)
                array.set(scores, i, array.get(scores, max_i))
                array.set(scores, max_i, t3)
                t4 = array.get(expectancies, i)
                array.set(expectancies, i, array.get(expectancies, max_i))
                array.set(expectancies, max_i, t4)
    
    // === MATRIX TABLO RENDER ===
    // Aktif MA türlerinin listesi (sütun olarak)
    enabled_types_list = array.new<string>()
    enabled_type_idx = array.new<int>()
    if use_sma
        array.push(enabled_types_list, "SMA")
        array.push(enabled_type_idx, 0)
    if use_ema
        array.push(enabled_types_list, "EMA")
        array.push(enabled_type_idx, 1)
    if use_wma
        array.push(enabled_types_list, "WMA")
        array.push(enabled_type_idx, 2)
    if use_vwma
        array.push(enabled_types_list, "VWMA")
        array.push(enabled_type_idx, 3)
    if use_kama
        array.push(enabled_types_list, "KAMA")
        array.push(enabled_type_idx, 4)
    if use_alma
        array.push(enabled_types_list, "ALMA")
        array.push(enabled_type_idx, 5)
    if use_hma
        array.push(enabled_types_list, "HMA")
        array.push(enabled_type_idx, 6)
    
    // Aktif periyotların listesi (satır olarak)
    enabled_periods_list = array.new<int>()
    if p3
        array.push(enabled_periods_list, 3)
    if p5
        array.push(enabled_periods_list, 5)
    if p8
        array.push(enabled_periods_list, 8)
    if p10
        array.push(enabled_periods_list, 10)
    if p13
        array.push(enabled_periods_list, 13)
    if p20
        array.push(enabled_periods_list, 20)
    if p21
        array.push(enabled_periods_list, 21)
    if p22
        array.push(enabled_periods_list, 22)
    if p34
        array.push(enabled_periods_list, 34)
    if p50
        array.push(enabled_periods_list, 50)
    if p55
        array.push(enabled_periods_list, 55)
    if p89
        array.push(enabled_periods_list, 89)
    if p100
        array.push(enabled_periods_list, 100)
    if p144
        array.push(enabled_periods_list, 144)
    if p200
        array.push(enabled_periods_list, 200)
    if p233
        array.push(enabled_periods_list, 233)
    if p250
        array.push(enabled_periods_list, 250)
    if p377
        array.push(enabled_periods_list, 377)
    if p610
        array.push(enabled_periods_list, 610)
    if p987
        array.push(enabled_periods_list, 987)
    
    all_period_seq = array.from(3,5,8,10,13,20,21,22,34,50,55,89,100,144,200,233,250,377,610,987)
    n_cols = array.size(enabled_types_list)
    n_rows_data = array.size(enabled_periods_list)
    
    // Top N global index seti (vurgu için)
    top_n_set = array.new<int>()
    for k = 0 to math.min(plot_top_n, nf) - 1
        array.push(top_n_set, array.get(idx_list, k))
    
    // Tabloyu temizle
    table.clear(tbl_main, 0, 0, 7, 21)
    
    // Başlık satırı
    hdr_bg = color.new(color.navy, 30)
    table.cell(tbl_main, 0, 0, "Per/MA", text_color=color.white, bgcolor=hdr_bg, text_size=table_size)
    if n_cols > 0
        for ti = 0 to n_cols - 1
            typ_s = array.get(enabled_types_list, ti)
            table.cell(tbl_main, ti+1, 0, typ_s, text_color=color.white, bgcolor=hdr_bg, text_size=table_size)
    
    // Veri satırları
    if n_rows_data > 0 and n_cols > 0
        for pi = 0 to n_rows_data - 1
            per = array.get(enabled_periods_list, pi)
            per_idx = array.indexof(all_period_seq, per)
            
            // İlk hücre: periyot
            table.cell(tbl_main, 0, pi+1, str.tostring(per), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=table_size)
            
            // MA hücreleri
            for ti = 0 to n_cols - 1
                ttype_idx = array.get(enabled_type_idx, ti)
                gidx = ttype_idx * 20 + per_idx
                
                ma_v = array.get(all_mas, gidx)
                tt_v = array.get(trend_touches, gidx)
                tr_v = array.get(trend_reacts, gidx)
                rt_v = array.get(range_touches, gidx)
                rr_v = array.get(range_reacts, gidx)
                tot_t = tt_v + rt_v
                tot_r = tr_v + rr_v
                
                // Top N kontrol
                is_top = false
                if array.size(top_n_set) > 0
                    for tk = 0 to array.size(top_n_set) - 1
                        if array.get(top_n_set, tk) == gidx
                            is_top := true
                            break
                
                if na(ma_v) or tot_t < min_touches
                    txt = na(ma_v) ? "—" : ("~\n" + str.tostring(tot_t) + " dok")
                    table.cell(tbl_main, ti+1, pi+1, txt, text_color=color.silver, bgcolor=color.new(color.gray, 80), text_size=table_size)
                else
                    rate = 100.0 * tot_r / tot_t
                    dist = (close - ma_v) / ma_v * 100
                    rsum = array.get(react_sums, gidx)
                    avg_react = tot_r > 0 ? rsum / tot_r : 0.0
                    
                    // Confidence grade (dokunma sayısına göre)
                    grade = tot_t >= 100 ? "A+" : tot_t >= 50 ? "A" : tot_t >= 25 ? "B" : "C"
                    
                    // Renk: top N siyan, yoksa rate'e göre gradient
                    // Confidence düşükse alpha artır (soluk göster)
                    alpha_boost = tot_t < 25 ? 15 : tot_t < 50 ? 5 : 0
                    bg = is_top ? color.new(color.aqua, 30) : rate >= 70 ? color.new(color.green, 50 + alpha_boost) : rate >= 50 ? color.new(color.lime, 65 + alpha_boost) : rate >= 30 ? color.new(color.yellow, 70 + alpha_boost) : color.new(color.red, 75 + alpha_boost)
                    txt_col = is_top ? color.black : color.white
                    
                    // Satır 1: tepki% + confidence grade
                    // Satır 2: ortalama tepki büyüklüğü
                    // Satır 3: MA değeri
                    // Satır 4: uzaklık
                    line1 = str.tostring(rate, "#.0") + "% " + grade
                    line2 = "Ø" + str.tostring(avg_react, "#.0") + "%"
                    line3 = str.tostring(ma_v, format.mintick)
                    line4 = str.tostring(dist, "+#.0;-#.0") + "%"
                    cell_txt = line1 + "\n" + line2 + "\n" + line3 + "\n" + line4
                    
                    table.cell(tbl_main, ti+1, pi+1, cell_txt, text_color=txt_col, bgcolor=bg, text_size=table_size)
    
    // === EN İYİLER ÖZET TABLOSU (Genişletilmiş: Expectancy + MAE + Hız + Rejim) ===
    // Composite skor: expectancy × √dokunma_sayısı (fund-manager yaklaşımı)
    table.clear(tbl_best, 0, 0, 12, 9)
    best_hdr_bg = color.new(color.teal, 30)
    table.cell(tbl_best, 0,  0, "#",      text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    table.cell(tbl_best, 1,  0, "MA",     text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    table.cell(tbl_best, 2,  0, "WR%",    text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    table.cell(tbl_best, 3,  0, "MFE",    text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Avg Maximum Favorable Excursion")
    table.cell(tbl_best, 4,  0, "MAE",    text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Avg Maximum Adverse Excursion")
    table.cell(tbl_best, 5,  0, "Exp",    text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Expectancy = WR×MFE - (1-WR)×MAE (WR ağırlıklı, klasik)")
    table.cell(tbl_best, 6,  0, "NetE",   text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Net Edge = Avg MFE - Avg MAE (WR'siz spread metric)")
    table.cell(tbl_best, 7,  0, "Brk",    text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Kırılım sayısı (düşük = MA gerçekten saygı görüyor)")
    table.cell(tbl_best, 8,  0, "T%",     text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Trendli piyasada tepki oranı")
    table.cell(tbl_best, 9,  0, "Y%",     text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size, tooltip="Yatay piyasada tepki oranı")
    table.cell(tbl_best, 10, 0, "Grade",  text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    table.cell(tbl_best, 11, 0, "Değer",  text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    table.cell(tbl_best, 12, 0, "Uzak%",  text_color=color.white, bgcolor=best_hdr_bg, text_size=table_size)
    
    best_rows = math.min(8, nf)
    if best_rows > 0
        for bi = 0 to best_rows - 1
            bidx = array.get(idx_list, bi)
            btyp = array.get(all_types, bidx)
            bper = array.get(all_pers, bidx)
            bma  = array.get(all_mas, bidx)
            brate = array.get(rates, bi)
            bexp = array.get(expectancies, bi)
            btt_trend = array.get(trend_touches, bidx)
            btt_range = array.get(range_touches, bidx)
            btr_trend = array.get(trend_reacts, bidx)
            btr_range = array.get(range_reacts, bidx)
            btt = btt_trend + btt_range
            btr = btr_trend + btr_range
            brsum = array.get(react_sums, bidx)
            bmsum = array.get(mae_sums, bidx)
            bbrk = array.get(brk_counts, bidx)
            bavg_mfe = btr > 0 ? brsum / btr : 0
            bavg_mae = btt > 0 ? bmsum / btt : 0
            brespect = btt > 0 ? math.max(0.0, 1.0 - bbrk / math.max(btt, 1)) * 100 : 0.0
            btrend_pct = btt_trend > 0 ? 100.0 * btr_trend / btt_trend : 0
            brange_pct = btt_range > 0 ? 100.0 * btr_range / btt_range : 0
            bgrade = btt >= 100 ? "A+" : btt >= 50 ? "A" : btt >= 25 ? "B" : "C"
            bdist = na(bma) ? 0 : (close - bma) / bma * 100
            row_bg = bi < plot_top_n ? color.new(color.aqua, 40) : color.new(color.gray, 75)
            row_txt = bi < plot_top_n ? color.black : color.white
            
            table.cell(tbl_best, 0,  bi+1, str.tostring(bi+1),                               text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 1,  bi+1, btyp + " " + str.tostring(bper),                  text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 2,  bi+1, str.tostring(brate, "#.0"),                       text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 3,  bi+1, str.tostring(bavg_mfe, "#.1"),                    text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 4,  bi+1, str.tostring(bavg_mae, "#.1"),                    text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            bnet_edge = bavg_mfe - bavg_mae
            table.cell(tbl_best, 5,  bi+1, str.tostring(bexp, "+#.2;-#.2"),                  text_color=bexp > 0 ? color.lime : color.red, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 6,  bi+1, str.tostring(bnet_edge, "+#.1;-#.1"),              text_color=bnet_edge > 0 ? color.lime : color.red, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 7,  bi+1, str.tostring(bbrk) + " (" + str.tostring(brespect, "#") + "%)",  text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 8,  bi+1, btt_trend > 0 ? str.tostring(btrend_pct, "#.0")+"%" : "—", text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 9,  bi+1, btt_range > 0 ? str.tostring(brange_pct, "#.0")+"%" : "—", text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 10, bi+1, bgrade,                                            text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 11, bi+1, na(bma) ? "—" : str.tostring(bma, format.mintick), text_color=row_txt, bgcolor=row_bg, text_size=table_size)
            table.cell(tbl_best, 12, bi+1, str.tostring(bdist, "+#.0;-#.0") + "%",            text_color=row_txt, bgcolor=row_bg, text_size=table_size)
    
    // === Sağ kenarda otomatik MA etiketleri (x_offset ile yan yana) ===
    if plot_top_n > 0 and nf > 0
        lpalette = array.from(color.fuchsia, color.aqua, color.yellow, color.red,
                               color.lime, color.orange, color.purple, color.white)
        for li = 0 to math.min(plot_top_n, nf) - 1
            lidx = array.get(idx_list, li)
            ltyp = array.get(all_types, lidx)
            lper = array.get(all_pers, lidx)
            lma  = array.get(all_mas, lidx)
            lrate = array.get(rates, li)
            lcol = array.get(lpalette, li % 8)
            // x_offset ile yan yana koyarak çakışmayı önle
            xoff = 3 + li * 12
            if not na(lma)
                ldist = (close - lma) / lma * 100
                ltxt_color = lcol == color.yellow or lcol == color.aqua or lcol == color.white or lcol == color.lime ? color.black : color.white
                new_lbl2 = label.new(bar_index + xoff, lma,
                     str.tostring(li+1) + ". " + ltyp + " " + str.tostring(lper) + 
                     " | " + str.tostring(lrate, "#.0") + "% | " + str.tostring(lma, format.mintick) +
                     " | " + str.tostring(ldist, "+#.0;-#.0") + "%",
                     color=lcol, textcolor=ltxt_color,
                     style=label.style_label_left, size=size.small)
                array.push(active_labels, new_lbl2)

    // === OTOMATİK ÇİZİM (ana tablo if içinde) ===
    if auto_draw_n > 0 and array.size(idx_list) > 0
        palette = array.from(color.fuchsia, color.aqua, color.yellow, color.red,
                              color.lime, color.orange, color.purple, color.white)
        n_to_draw = math.min(auto_draw_n, array.size(idx_list))
        lb = math.min(draw_lookback, bar_index)
    
        for ni = 0 to n_to_draw - 1
            ma_idx = array.get(idx_list, ni)
            col = array.get(palette, ni % 8)
        
            // Polyline noktalarını topla (eskiden yeniye)
            pts = array.new<chart.point>()
            for k = lb to 0
                v = ma_idx < 60 ? get_ma_at_a(ma_idx, k) : ma_idx < 120 ? get_ma_at_b(ma_idx, k) : get_ma_at_c(ma_idx, k)
                if not na(v)
                    array.push(pts, chart.point.from_index(bar_index - k, v))
        
            if array.size(pts) > 1
                new_pl = polyline.new(pts, line_color=col, line_width=draw_width, closed=false, curved=false)
                array.push(active_lines, new_pl)
        
            // Sağ kenarda etiket
            if show_auto_label
                last_val = ma_idx < 60 ? get_ma_at_a(ma_idx, 0) : ma_idx < 120 ? get_ma_at_b(ma_idx, 0) : get_ma_at_c(ma_idx, 0)
                typ_s = array.get(all_types, ma_idx)
                per_v = array.get(all_pers, ma_idx)
                rate = array.get(rates, ni)
                if not na(last_val)
                    new_lbl = label.new(bar_index + 3, last_val,
                         str.tostring(ni+1) + ". " + typ_s + " " + str.tostring(per_v) + " (" + str.tostring(rate, "#.0") + "%)",
                         color=col, textcolor=col == color.yellow or col == color.lime or col == color.white or col == color.aqua ? color.black : color.white,
                         style=label.style_label_left, size=size.small)
                    array.push(active_labels, new_lbl)

// =================== MTF BİRLEŞİK TABLO (Haftalık + Aylık) ===================

if barstate.islast and show_htf
    // === MTF MATRIX TABLO (W veya M - kullanıcı seçer) ===
    table.clear(tbl_mtf, 0, 0, 7, 21)
    hdr_bg_mtf = color.new(color.purple, 30)
    
    // Kullanıcının seçimine göre hangi array kullanılacak
    selected_mas = mtf_view_s == "Haftalık" ? w_mas : m_mas
    tf_label = mtf_view_s == "Haftalık" ? "W" : "M"
    
    // Ana tablo bloğundan ayrı bir scope olduğu için listeleri burada yeniden oluştur
    enabled_types_list = array.new<string>()
    enabled_type_idx = array.new<int>()
    if use_sma
        array.push(enabled_types_list, "SMA")
        array.push(enabled_type_idx, 0)
    if use_ema
        array.push(enabled_types_list, "EMA")
        array.push(enabled_type_idx, 1)
    if use_wma
        array.push(enabled_types_list, "WMA")
        array.push(enabled_type_idx, 2)
    if use_vwma
        array.push(enabled_types_list, "VWMA")
        array.push(enabled_type_idx, 3)
    if use_kama
        array.push(enabled_types_list, "KAMA")
        array.push(enabled_type_idx, 4)
    if use_alma
        array.push(enabled_types_list, "ALMA")
        array.push(enabled_type_idx, 5)
    if use_hma
        array.push(enabled_types_list, "HMA")
        array.push(enabled_type_idx, 6)
    
    enabled_periods_list = array.new<int>()
    if p3
        array.push(enabled_periods_list, 3)
    if p5
        array.push(enabled_periods_list, 5)
    if p8
        array.push(enabled_periods_list, 8)
    if p10
        array.push(enabled_periods_list, 10)
    if p13
        array.push(enabled_periods_list, 13)
    if p20
        array.push(enabled_periods_list, 20)
    if p21
        array.push(enabled_periods_list, 21)
    if p22
        array.push(enabled_periods_list, 22)
    if p34
        array.push(enabled_periods_list, 34)
    if p50
        array.push(enabled_periods_list, 50)
    if p55
        array.push(enabled_periods_list, 55)
    if p89
        array.push(enabled_periods_list, 89)
    if p100
        array.push(enabled_periods_list, 100)
    if p144
        array.push(enabled_periods_list, 144)
    if p200
        array.push(enabled_periods_list, 200)
    if p233
        array.push(enabled_periods_list, 233)
    if p250
        array.push(enabled_periods_list, 250)
    if p377
        array.push(enabled_periods_list, 377)
    if p610
        array.push(enabled_periods_list, 610)
    if p987
        array.push(enabled_periods_list, 987)
    
    all_period_seq = array.from(3,5,8,10,13,20,21,22,34,50,55,89,100,144,200,233,250,377,610,987)
    
    // Başlık satırı - matrix tablo gibi
    table.cell(tbl_mtf, 0, 0, "Per-" + tf_label, text_color=color.white, bgcolor=hdr_bg_mtf, text_size=table_size)
    if array.size(enabled_types_list) > 0
        for ti2 = 0 to array.size(enabled_types_list) - 1
            typ_s = array.get(enabled_types_list, ti2)
            table.cell(tbl_mtf, ti2+1, 0, typ_s, text_color=color.white, bgcolor=hdr_bg_mtf, text_size=table_size)
    
    // Veri satırları
    if array.size(enabled_periods_list) > 0 and array.size(enabled_types_list) > 0
        for pi2 = 0 to array.size(enabled_periods_list) - 1
            per2 = array.get(enabled_periods_list, pi2)
            per_idx2 = array.indexof(all_period_seq, per2)
            
            // İlk hücre: periyot
            table.cell(tbl_mtf, 0, pi2+1, str.tostring(per2), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=table_size)
            
            // MA hücreleri
            for ti2 = 0 to array.size(enabled_types_list) - 1
                ttype_idx2 = array.get(enabled_type_idx, ti2)
                gidx2 = ttype_idx2 * 20 + per_idx2
                
                mtf_val = array.get(selected_mas, gidx2)
                if not na(mtf_val)
                    d2 = (close - mtf_val) / mtf_val * 100
                    near2 = math.abs(d2) < 1.5
                    bg2 = near2 ? color.new(color.aqua, 40) : color.new(color.gray, 80)
                    txt2 = str.tostring(mtf_val, format.mintick) + "\n" + str.tostring(d2, "+#.0;-#.0") + "%"
                    table.cell(tbl_mtf, ti2+1, pi2+1, txt2, text_color=color.white, bgcolor=bg2, text_size=table_size)
                else
                    table.cell(tbl_mtf, ti2+1, pi2+1, "—", text_color=color.silver, bgcolor=color.new(color.gray, 85), text_size=table_size)

// =================== HTF2 (Aylık) TABLOSU ===================


// =================== REJİM ARKA PLAN GÖSTERGESİ ===================
bgcolor(is_trending ? color.new(color.green, 95) : color.new(color.orange, 95), title="Rejim (yeşil=trend, turuncu=yatay)")



